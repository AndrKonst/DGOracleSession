<idea-plugin>
    <id>io.github.andrkonst.dgoraclesession</id>
    <name>DGOracleSession</name>
    <vendor url="https://github.com/AndrKonst">Andronov Konstantin</vendor>
    <description><![CDATA[
        <p>Oracle sessions monitor for DataGrip: a tool window with configurable query tabs,
        similar to the Sessions window in PL/SQL Developer.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.database</depends>

    <resource-bundle>messages.DGOracleSessionBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="DGOracleSession"
                    anchor="bottom"
                    icon="/icons/dgOracleSession.svg"
                    factoryClass="io.github.andrkonst.dgoraclesession.toolwindow.SessionsToolWindowFactory"/>
        <notificationGroup id="DGOracleSession" displayType="BALLOON"/>
        <fileEditorProvider implementation="io.github.andrkonst.dgoraclesession.html.HtmlReportEditorProvider"/>
        <applicationConfigurable parentId="tools"
                                 id="io.github.andrkonst.dgoraclesession.settings"
                                 instance="io.github.andrkonst.dgoraclesession.settings.QueryTabsConfigurable"
                                 key="settings.display.name"/>
    </extensions>

    <actions>
        <group id="DGOracleSession.SessionActions">
            <action id="DGOracleSession.KillSessionImmediate"
                    class="io.github.andrkonst.dgoraclesession.actions.KillSessionImmediateAction"
                    icon="AllIcons.Debugger.KillProcess"/>
            <action id="DGOracleSession.DisconnectSessionImmediate"
                    class="io.github.andrkonst.dgoraclesession.actions.DisconnectSessionImmediateAction"
                    icon="AllIcons.Actions.Exit"/>
        </group>
        <action id="DGOracleSession.OpenSettings"
                class="io.github.andrkonst.dgoraclesession.actions.OpenSettingsAction"
                icon="AllIcons.General.Settings"/>
        <group id="DGOracleSession.ToolbarActions">
            <reference ref="DGOracleSession.SessionActions"/>
            <separator/>
            <reference ref="DGOracleSession.OpenSettings"/>
        </group>
    </actions>
</idea-plugin>
